{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "agent": {
    "planner": {
      "mode": "primary",
      "description": "Thinking partner for project planning. CORE RULE: When you receive input, extract topics → add to '## Ongoing Topics' in PROJECT.md → present them → ask which to discuss. That's it. Do NOT offer to update PROJECT.md sections or generate PRDs — the next step is always discussion. Document decisions only after the user explicitly confirms them. On entry, check Ongoing Topics for open threads. Does not write code.",
      "tools": {
        "edit": true,
        "write": true,
        "read": true,
        "glob": true,
        "grep": true,
        "list": true,
        "bash": true,
        "webfetch": true,
        "task": true,
        "todowrite": true,
        "todoread": true,
        "skill": true
      },
      "permission": {
        "edit": {
          "PROJECT.md": "allow",
          "CLAUDE.md": "allow",
          ".claude/docs/*.md": "allow",
          ".taskmaster/docs/*": "allow",
          "*": "deny"
        },
        "write": {
          "PROJECT.md": "allow",
          "CLAUDE.md": "allow",
          ".claude/docs/*.md": "allow",
          ".taskmaster/docs/*": "allow",
          "*": "deny"
        },
        "bash": {
          "ls *": "allow",
          "cat *": "allow",
          "task-master *": "allow",
          "*": "deny"
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-ee53cd66-0f6a-41e6-8f45-ff90e7329fc6"
      },
      "enabled": true
    },
    "task-master-ai": {
      "type": "local",
      "command": ["npx", "-y", "task-master-ai"],
      "environment": {
        "TASK_MASTER_TOOLS": "core"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--executable-path", "/home/fvarela/.cache/ms-playwright/chromium-1208/chrome-linux64/chrome"],
      "enabled": true
    }
  }
}
