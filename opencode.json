{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-sonnet-5.5",
  "provider": {
    "github-copilot": {
      "models": {
        "gpt-5.6-luna": {
          "options": {
            "reasoningEffort": "max"
          }
        },
        "gpt-6-luna": {
          "options": {
            "reasoningEffort": "max"
          }
        }
      }
    },
    "casa": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Servidor de casa",
      "options": {
        "baseURL": "http://192.168.1.148:1234/v1"
      },
      "models": {
        "google/gemma-4-26b-a4b-qat": {
          "name": "Gemma 4 26B (local)",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "az *": "ask",
      "databricks *permissions *": "ask",
      "databricks *grants *": "ask",
      "databricks *secrets *": "ask",
      "databricks *service-principals *": "ask",
      "databricks *tokens *": "ask"
    }
  },
  "agent": {
    "build": {
      "mode": "primary"
    },
    "explore": {
      "model": "github-copilot/claude-sonnet-5.5"
    },
    "plan": {
      "disable": true
    },
    "assisted": {
      "mode": "primary",
      "description": "Senior dev guiding you through implementation — you write the code",
      "prompt": "{file:./agents/assisted.md}",
      "tools": {
        "edit": true,
        "write": true,
        "read": true,
        "glob": false,
        "grep": true,
        "list": true,
        "bash": true,
        "webfetch": true,
        "task": true,
        "todowrite": true
      }
    },
    "project-planner": {
      "description": "Plans work in this repository and writes prompts for the coding agent, which you run with /run. Reads only AGENTS.md and keeps it up to date.",
      "mode": "primary",
      "model": "github-copilot/claude-opus-5.5",
      "prompt": "{file:./prompts/project-planner.md}",
      "permission": {
        "*": "deny",
        "read": {
          "*": "deny",
          "AGENTS.md": "allow",
          "**/AGENTS.md": "allow",
          ".agents/plan/*": "allow",
          "**/.agents/plan/*": "allow"
        },
        "edit": {
          "*": "deny",
          "AGENTS.md": "allow",
          "**/AGENTS.md": "allow",
          ".agents/plan/prompt.md": "allow",
          "**/.agents/plan/prompt.md": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow"
        },
        "question": "allow",
        "todowrite": "allow"
      }
    },
    "project-planner-auto": {
      "description": "Like project-planner, but hands each prompt to the coder subagent after your approval and gets the report back automatically.",
      "mode": "primary",
      "model": "github-copilot/claude-opus-5.5",
      "prompt": "{file:./prompts/project-planner.md}",
      "permission": {
        "*": "deny",
        "read": {
          "*": "deny",
          "AGENTS.md": "allow",
          "**/AGENTS.md": "allow"
        },
        "edit": {
          "*": "deny",
          "AGENTS.md": "allow",
          "**/AGENTS.md": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "coder": "ask"
        },
        "question": "allow",
        "todowrite": "allow"
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--caps",
        "vision,pdf",
        "--save-session"
      ],
      "environment": {
        "PLAYWRIGHT_MCP_IMAGE_RESPONSES": "allow",
        "PLAYWRIGHT_MCP_SNAPSHOT_MODE": "full"
      },
      "enabled": false
    },
    "obsidian-vault": {
      "type": "remote",
      "url": "http://127.0.0.1:27124/mcp",
      "enabled": false
    }
  }
}
